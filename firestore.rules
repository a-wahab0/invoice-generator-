rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /invoices/{invoiceId} {

      // Read/update/delete only your own invoices.
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.ownerId;

      // Create only if you stamp yourself as the owner,
      // and keep the payload sane (avoid junk/huge documents).
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerId
        && request.resource.data.invoiceNumber is string
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 200;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
